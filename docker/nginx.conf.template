worker_processes auto;
pid /run/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    server_tokens   off;
    client_max_body_size 25M;

    # Logs to Render's stdout/stderr
    access_log /dev/stdout combined;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/javascript application/javascript
        application/json application/xml application/xml+rss
        image/svg+xml;

    # Render terminates TLS at its edge and forwards over HTTP with X-Forwarded-Proto.
    # Trust the forwarded scheme so Laravel knows the request is HTTPS.
    map $http_x_forwarded_proto $forwarded_scheme {
        default $scheme;
        https   https;
    }

    server {
        listen ${PORT};
        listen [::]:${PORT};
        server_name _;

        root  /var/www/html/public;
        index index.php;

        # Trust real client IP from Render's proxy
        set_real_ip_from 0.0.0.0/0;
        real_ip_header   X-Forwarded-For;

        # Health probe for Render
        location = /up {
            try_files $uri /index.php?$query_string;
        }

        # Static asset routing — never let nginx try to PHP-execute these
        location ~* ^/(storage|build|favicon\.ico|robots\.txt) {
            try_files $uri =404;
            expires 7d;
            add_header Cache-Control "public, immutable";
        }

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            fastcgi_pass  127.0.0.1:9000;
            fastcgi_index index.php;
            include       fastcgi_params;
            fastcgi_param SCRIPT_FILENAME    $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO          $fastcgi_path_info;
            fastcgi_param HTTPS              on;
            fastcgi_param HTTP_X_FORWARDED_PROTO $forwarded_scheme;
            fastcgi_read_timeout 60;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
        }

        # Block access to dotfiles + sensitive files
        location ~ /\.(?!well-known).* {
            deny all;
        }
        location ~* \.(env|sql|sqlite|ini|log|conf)$ {
            deny all;
        }
    }
}
